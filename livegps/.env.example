APPLICATION=livegps
LOG_LEVEL=2
LOG_TYPE=console
LOG_COLOR=false

CH_HOST=127.0.0.1
CH_PORT=8123
CH_DATABASE=vagstats
CH_USER=default
CH_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
REDIS_DB=0

# all: unfiltered getVehicles(); tiles: sequential bounding-box scan
LIVEGPS_FETCH_MODE=all
LIVEGPS_SCAN_INTERVAL_MS=10000
WATCHDOG_TIMEOUT=60
LIVEGPS_WEST=8.9
LIVEGPS_SOUTH=47.2
LIVEGPS_EAST=13.9
LIVEGPS_NORTH=50.6
LIVEGPS_TILE_SIZE_DEGREES=0.5
LIVEGPS_TILE_DELAY_MS=500
LIVEGPS_CACHE_TTL_SECONDS=180
LIVEGPS_BATCH_SIZE=500
