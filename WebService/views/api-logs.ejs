<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>API Logs - VAG Stats</title>
  <link rel="stylesheet" href="/dist/css/tailwind.css" />
  <style>
    .trace-grid { display:grid; grid-template-columns:12rem minmax(12rem,1fr) minmax(14rem,1.2fr) 7rem minmax(14rem,1fr); gap:.75rem; }
    .trace-row { border-top:1px solid #e2e8f0; padding:.75rem 1rem; align-items:start; }
    .trace-json { white-space:pre-wrap; word-break:break-word; max-height:28rem; overflow:auto; }
    @media (max-width:900px) { .trace-grid { grid-template-columns:1fr; } .trace-head { display:none; } }
  </style>
</head>
<body class="vag-page">
  <main class="vag-shell">
    <header class="vag-header">
      <div><h1 class="vag-title">Upstream API Logs</h1><p class="vag-subtitle">Zeitlich begrenzte Aufnahmen aus Scanner, Processor und WebService.</p></div>
      <a href="/" class="vag-button-secondary">Zurück</a>
    </header>

    <section id="sharedBanner" class="vag-panel hidden"><strong>Geteilte Aufnahme</strong><span class="ml-2 text-sm text-slate-600">Nur dieser Log ist ohne Admin-Token sichtbar.</span></section>

    <section id="loginPanel" class="vag-panel">
      <div class="flex flex-wrap items-end gap-3">
        <div class="vag-field min-w-72 flex-1"><label class="vag-label" for="token">Admin-Token aus ADMIN_TOKEN</label><input id="token" class="vag-input" type="password" autocomplete="off" placeholder="Admin-Token" /></div>
        <button id="connect" class="vag-button" type="button">Verbinden</button>
      </div>
    </section>

    <section id="recordingPanel" class="vag-panel mt-4 hidden">
      <div class="flex flex-wrap items-end gap-3">
        <div class="vag-field"><label class="vag-label" for="recordingHours">Aufnahmedauer</label><select id="recordingHours" class="vag-input"><option value="1">1 Stunde</option><option value="2">2 Stunden</option><option value="4">4 Stunden</option><option value="8">8 Stunden</option><option value="12">12 Stunden</option><option value="24">24 Stunden</option></select></div>
        <button id="startRecording" class="vag-button" type="button">Aufnahme starten</button>
        <button id="stopRecording" class="vag-button-secondary" type="button" disabled>Aufnahme beenden</button>
        <div class="text-sm">Status: <strong id="status">Inaktiv</strong></div><div class="text-sm">Einträge: <strong id="count">-</strong></div><div class="text-sm">Speicher: <strong id="bytes">-</strong></div>
      </div>
      <div id="activeRecording" class="mt-3 text-sm text-slate-600"></div>
      <div id="shareBox" class="mt-3 hidden rounded bg-emerald-50 p-3 text-sm">
        <label class="vag-label" for="shareUrl">Share-Link (Token wird nur jetzt angezeigt)</label>
        <div class="flex gap-2"><input id="shareUrl" class="vag-input flex-1" readonly /><button id="copyShare" class="vag-button-secondary" type="button">Kopieren</button></div>
      </div>
      <div class="mt-4 flex flex-wrap items-end gap-3">
        <div class="vag-field min-w-72 flex-1"><label class="vag-label" for="recordingSelect">Gespeicherte Aufnahmen</label><select id="recordingSelect" class="vag-input"></select></div>
        <button id="loadRecording" class="vag-button-secondary" type="button">Datei laden</button><button id="downloadRecording" class="vag-button-secondary" type="button">Datei herunterladen</button>
      </div>
    </section>

    <section class="vag-control-bar mt-4">
      <div class="vag-field flex-1 min-w-56"><label class="vag-label" for="filter">Filter</label><input id="filter" class="vag-input" type="search" placeholder="Route, Parameter, Code oder Inhalt" /></div>
      <button id="refresh" class="vag-button-secondary" type="button">Aktualisieren</button><span id="viewState" class="text-sm text-slate-600">Noch keine Datei geladen</span>
    </section>

    <section class="vag-card mt-4 overflow-hidden">
      <div class="trace-grid trace-head bg-slate-100 px-4 py-3 text-xs font-semibold uppercase text-slate-500"><span>Uhrzeit</span><span>Route</span><span>Parameter</span><span>HTTP-Code</span><span>Request / Response</span></div>
      <div id="logs"><p class="p-6 text-center text-slate-500">Admin-Token eingeben oder Share-Link öffnen.</p></div>
    </section>
  </main>
  <script src="/dist/js/api-logs.js?v=3"></script>
</body>
</html>
