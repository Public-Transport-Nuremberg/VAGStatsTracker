# Copy this file to .env. The real .env is ignored by Git.

# These split variables match WebService/.env. Alternatively, set REDIS_URL.
REDIS_HOST=192.168.120.3
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=username
REDIS_PASSWORD=change-me
# REDIS_URL=redis://username:password@192.168.120.3:6379/0

# ClickHouse HTTP endpoint used only by router-builder, never by router-api.
# CH_URL takes precedence over CH_HOST + CH_PORT.
CH_HOST=192.168.120.3
CH_PORT=8123
# CH_URL=http://192.168.120.3:8123
CH_DATABASE=vag_stats
CH_USER=default
CH_PASSWORD=change-me

# Historical delays stored by ClickHouse: seconds or minutes.
HISTORY_DELAY_UNIT=seconds

# Resumable statistics build. Smaller chunks checkpoint more often; larger chunks
# have less ClickHouse overhead. Must be between 1 and 366.
HISTORY_CHUNK_DAYS=30
# HISTORY_CHECKPOINT_FILE=data/stats-builder.checkpoint.zst

# Optional runtime settings.
RUST_LOG=info
# BUILDER_METRICS_FILE=data/router-builder.prom
